{
  "openapi": "3.1.0",
  "info": {
    "title": "Cropstar API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/healthz": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Read Liveness",
        "description": "Liveness probe for the container orchestrator; intentionally does no I/O.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Read Status",
        "description": "Report whether the database is reachable and which PostgreSQL and PostGIS it runs.",
        "operationId": "getStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiStatus": {
        "properties": {
          "service": {
            "type": "string",
            "const": "cropstar-api",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          }
        },
        "type": "object",
        "required": [
          "service",
          "version",
          "database"
        ],
        "title": "ApiStatus"
      },
      "DatabaseStatus": {
        "properties": {
          "reachable": {
            "type": "boolean",
            "title": "Reachable"
          },
          "postgres_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postgres Version"
          },
          "postgis_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postgis Version"
          }
        },
        "type": "object",
        "required": [
          "reachable",
          "postgres_version",
          "postgis_version"
        ],
        "title": "DatabaseStatus"
      },
      "Liveness": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "const": "cropstar-api",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "Liveness"
      }
    }
  }
}
