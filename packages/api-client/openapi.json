{
  "openapi": "3.1.0",
  "info": {
    "title": "Cropstar API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/healthz": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Read Liveness",
        "description": "Liveness probe for the container orchestrator; intentionally does no I/O.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Read Status",
        "description": "Report whether the database is reachable and which PostgreSQL and PostGIS it runs.",
        "operationId": "getStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/config": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Read Auth Config",
        "description": "What this instance offers before anyone is signed in.",
        "operationId": "getAuthConfig",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "description": "Create a User and their first Farm with them as its Admin, then sign them in.",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-in": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign In",
        "operationId": "signIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign Out",
        "operationId": "signOut",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/auth/password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Change Password",
        "description": "Change the password; every other session of this user is signed out.",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/password-reset/request": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Request Password Reset",
        "description": "Email a reset link if the address belongs to a User. The answer never tells which.",
        "operationId": "requestPasswordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/password-reset/complete": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Complete Password Reset",
        "operationId": "completePasswordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetCompletion"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Read Me",
        "description": "The signed-in User and the Farms they are a member of.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        }
      }
    },
    "/api/farms/{farm_id}/harvest-years": {
      "get": {
        "tags": [
          "areas"
        ],
        "summary": "List Harvest Years",
        "description": "Harvest Years the Farm has Fields in, most recent first.",
        "operationId": "listHarvestYears",
        "parameters": [
          {
            "name": "farm_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Farm Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "title": "Response Listharvestyears"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/farms/{farm_id}/fields": {
      "get": {
        "tags": [
          "areas"
        ],
        "summary": "List Fields",
        "operationId": "listFields",
        "parameters": [
          {
            "name": "farm_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Farm Id"
            }
          },
          {
            "name": "harvest_year",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 2200,
              "minimum": 1990,
              "title": "Harvest Year"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldCollection"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/farms/{farm_id}/plots": {
      "get": {
        "tags": [
          "areas"
        ],
        "summary": "List Plots",
        "operationId": "listPlots",
        "parameters": [
          {
            "name": "farm_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Farm Id"
            }
          },
          {
            "name": "harvest_year",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 2200,
              "minimum": 1990,
              "title": "Harvest Year"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlotCollection"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/farms/{farm_id}/plots/{plot_id}": {
      "get": {
        "tags": [
          "areas"
        ],
        "summary": "Read Plot",
        "operationId": "getPlot",
        "parameters": [
          {
            "name": "plot_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Plot Id"
            }
          },
          {
            "name": "farm_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Farm Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlotFeature"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiStatus": {
        "properties": {
          "service": {
            "type": "string",
            "const": "cropstar-api",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          }
        },
        "type": "object",
        "required": [
          "service",
          "version",
          "database"
        ],
        "title": "ApiStatus"
      },
      "AuthConfig": {
        "properties": {
          "registration_open": {
            "type": "boolean",
            "title": "Registration Open"
          },
          "password_reset_by_email": {
            "type": "boolean",
            "title": "Password Reset By Email"
          }
        },
        "type": "object",
        "required": [
          "registration_open",
          "password_reset_by_email"
        ],
        "title": "AuthConfig"
      },
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "type": "string",
            "maxLength": 256,
            "title": "Current Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 8,
            "title": "New Password"
          }
        },
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest"
      },
      "DatabaseStatus": {
        "properties": {
          "reachable": {
            "type": "boolean",
            "title": "Reachable"
          },
          "postgres_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postgres Version"
          },
          "postgis_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postgis Version"
          }
        },
        "type": "object",
        "required": [
          "reachable",
          "postgres_version",
          "postgis_version"
        ],
        "title": "DatabaseStatus"
      },
      "FarmOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "FarmOut"
      },
      "FieldCollection": {
        "properties": {
          "type": {
            "type": "string",
            "const": "FeatureCollection",
            "title": "Type",
            "default": "FeatureCollection"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/FieldFeature"
            },
            "type": "array",
            "title": "Features"
          }
        },
        "type": "object",
        "required": [
          "features"
        ],
        "title": "FieldCollection"
      },
      "FieldFeature": {
        "properties": {
          "type": {
            "type": "string",
            "const": "Feature",
            "title": "Type",
            "default": "Feature"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "geometry": {
            "$ref": "#/components/schemas/MultiPolygon"
          },
          "properties": {
            "$ref": "#/components/schemas/FieldProperties"
          }
        },
        "type": "object",
        "required": [
          "id",
          "geometry",
          "properties"
        ],
        "title": "FieldFeature"
      },
      "FieldProperties": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "harvest_year": {
            "type": "integer",
            "title": "Harvest Year"
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "land_use_code": {
            "type": "string",
            "title": "Land Use Code"
          },
          "land_use_name": {
            "type": "string",
            "title": "Land Use Name"
          },
          "declared_area_ha": {
            "type": "number",
            "title": "Declared Area Ha"
          },
          "plot_count": {
            "type": "integer",
            "title": "Plot Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "harvest_year",
          "number",
          "name",
          "land_use_code",
          "land_use_name",
          "declared_area_ha",
          "plot_count"
        ],
        "title": "FieldProperties"
      },
      "FieldRef": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "number",
          "name"
        ],
        "title": "FieldRef"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LandUseCategory": {
        "type": "string",
        "enum": [
          "cereals",
          "legumes",
          "root_crops",
          "oilseeds",
          "fodder",
          "vegetables",
          "fallow",
          "grassland",
          "permanent",
          "other"
        ],
        "title": "LandUseCategory"
      },
      "Liveness": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "const": "cropstar-api",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "Liveness"
      },
      "Me": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserOut"
          },
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/MembershipOut"
            },
            "type": "array",
            "title": "Memberships"
          }
        },
        "type": "object",
        "required": [
          "user",
          "memberships"
        ],
        "title": "Me"
      },
      "MembershipOut": {
        "properties": {
          "farm": {
            "$ref": "#/components/schemas/FarmOut"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "type": "object",
        "required": [
          "farm",
          "role"
        ],
        "title": "MembershipOut"
      },
      "MultiPolygon": {
        "properties": {
          "type": {
            "type": "string",
            "const": "MultiPolygon",
            "title": "Type"
          },
          "coordinates": {
            "items": {
              "items": {
                "items": {
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array",
                  "maxItems": 2,
                  "minItems": 2
                },
                "type": "array"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Coordinates"
          }
        },
        "type": "object",
        "required": [
          "type",
          "coordinates"
        ],
        "title": "MultiPolygon"
      },
      "PasswordResetCompletion": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200,
            "title": "Token"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "title": "PasswordResetCompletion"
      },
      "PasswordResetRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "title": "Email"
          },
          "locale": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ],
            "title": "Locale",
            "default": "de"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "PasswordResetRequest"
      },
      "PlotCollection": {
        "properties": {
          "type": {
            "type": "string",
            "const": "FeatureCollection",
            "title": "Type",
            "default": "FeatureCollection"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/PlotFeature"
            },
            "type": "array",
            "title": "Features"
          }
        },
        "type": "object",
        "required": [
          "features"
        ],
        "title": "PlotCollection"
      },
      "PlotFeature": {
        "properties": {
          "type": {
            "type": "string",
            "const": "Feature",
            "title": "Type",
            "default": "Feature"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "geometry": {
            "$ref": "#/components/schemas/MultiPolygon"
          },
          "properties": {
            "$ref": "#/components/schemas/PlotProperties"
          }
        },
        "type": "object",
        "required": [
          "id",
          "geometry",
          "properties"
        ],
        "title": "PlotFeature"
      },
      "PlotProperties": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "harvest_year": {
            "type": "integer",
            "title": "Harvest Year"
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "land_use_code": {
            "type": "string",
            "title": "Land Use Code"
          },
          "land_use_name": {
            "type": "string",
            "title": "Land Use Name"
          },
          "land_use_category": {
            "$ref": "#/components/schemas/LandUseCategory"
          },
          "declared_area_ha": {
            "type": "number",
            "title": "Declared Area Ha"
          },
          "field": {
            "$ref": "#/components/schemas/FieldRef"
          }
        },
        "type": "object",
        "required": [
          "id",
          "harvest_year",
          "number",
          "name",
          "land_use_code",
          "land_use_name",
          "land_use_category",
          "declared_area_ha",
          "field"
        ],
        "title": "PlotProperties"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 8,
            "title": "Password"
          },
          "farm_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Farm Name"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "farm_name"
        ],
        "title": "RegisterRequest"
      },
      "Role": {
        "type": "string",
        "enum": [
          "admin",
          "worker",
          "advisor"
        ],
        "title": "Role"
      },
      "SignInRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
