{
  "name": "@cropstar/api-client",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Typed client for the Cropstar API, generated from its OpenAPI schema",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0"
  }
}
